<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.kelompok2.portalsiswa.ParticleView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/GlassCardStyle"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="20dp"
                        android:text="Daftar Akun Baru"
                        android:textColor="@color/text_white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- 1. Username Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="12dp"
                        app:cardBackgroundColor="@color/glass_card_bg_input"
                        app:cardCornerRadius="10dp"
                        app:strokeColor="@color/gold_primary"
                        app:strokeWidth="1dp">

                        <EditText
                            android:id="@+id/etRegUsername"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:hint="Masukkan username"
                            android:paddingHorizontal="12dp"
                            android:textColor="@color/text_white"
                            android:textColorHint="@color/text_muted"
                            android:textSize="14sp" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 2. Email Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="12dp"
                        app:cardBackgroundColor="@color/glass_card_bg_input"
                        app:cardCornerRadius="10dp"
                        app:strokeColor="@color/gold_primary"
                        app:strokeWidth="1dp">

                        <EditText
                            android:id="@+id/etRegEmail"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:hint="Masukkan email"
                            android:inputType="textEmailAddress"
                            android:paddingHorizontal="12dp"
                            android:textColor="@color/text_white"
                            android:textColorHint="@color/text_muted"
                            android:textSize="14sp" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 3. Password Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="12dp"
                        app:cardBackgroundColor="@color/glass_card_bg_input"
                        app:cardCornerRadius="10dp"
                        app:strokeColor="@color/gold_primary"
                        app:strokeWidth="1dp">

                        <EditText
                            android:id="@+id/etRegPassword"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:hint="Masukkan password"
                            android:inputType="textPassword"
                            android:paddingHorizontal="12dp"
                            android:textColor="@color/text_white"
                            android:textColorHint="@color/text_muted"
                            android:textSize="14sp" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 4. Role Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="20dp"
                        app:cardBackgroundColor="@color/glass_card_bg_input"
                        app:cardCornerRadius="10dp"
                        app:strokeColor="@color/gold_primary"
                        app:strokeWidth="1dp">

                        <Spinner
                            android:id="@+id/spRoleRegister"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingHorizontal="8dp" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Tombol Batal & Simpan -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnBatal"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="Batal"
                            android:textColor="@color/gold_primary"
                            app:cornerRadius="10dp"
                            app:strokeColor="@color/gold_primary" />

                        <Button
                            android:id="@+id/btnRegister"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/gold_primary"
                            android:text="Simpan"
                            android:textColor="#000000"
                            android:textStyle="bold"
                            app:cornerRadius="10dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PortalSiswa" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Status Bar & Navigation Bar Gelap Transparan -->
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="colorPrimary">@color/gold_primary</item>
    </style>

    <!-- Style Kartu Biru Tua Transparan 50% + Lis Emas -->
    <style name="GlassCardStyle">
        <item name="cardBackgroundColor">@color/glass_card_bg</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/gold_primary</item>
        <item name="strokeWidth">1.5dp</item>
    </style>
</resources>